{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum by (route) (rate(smartinventory_http_requests_by_route_total{route=~\"/api/.*\"}[5m]))", "legendFormat": "{{route}}", "refId": "A" }],
      "title": "Requests per Route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "rate(smartinventory_http_request_duration_seconds_sum{route=~\"/api/.*\"}[5m]) / clamp_min(rate(smartinventory_http_request_duration_seconds_count{route=~\"/api/.*\"}[5m]), 0.001)", "legendFormat": "Average API latency", "refId": "A" }],
      "title": "Average API Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "sum by (route, status) (rate(smartinventory_http_responses_total{route=~\"/api/.*\"}[5m]))", "legendFormat": "{{route}} {{status}}", "refId": "A" }],
      "title": "Response Status Rate",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["smartinventory", "api"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
